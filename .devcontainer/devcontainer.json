{
  "containerUser": "node",
  "customizations": {
    "vscode": {
      "extensions": ["EditorConfig.EditorConfig", "Tyriar.sort-lines", "docker.docker", "ms-azuretools.vscode-containers", "ms-vscode.makefile-tools"],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.organizeImports": "always",
          "source.organizeLinkDefinitions": "always",
          "source.sort.json": "always"
        },
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "dockerComposeFile": ["../docker-compose-devcontainer.yml"],
  "init": true,
  "postCreateCommand": "make postcreate",
  "remoteUser": "node",
  "service": "devcontainer",
  "workspaceFolder": "/workspace"
}
